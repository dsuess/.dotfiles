{
  "arch": "aarch64",
  "distro": "alpine",
  "alpine": {
    "version": "3.23.0",
    "kernelPackage": "linux-virt",
    "kernelImage": "vmlinuz-virt",
    "rootfsPackages": [],
    "initramfsPackages": []
  },
  "oci": {
    "image": "pi-gondolin-rootfs:build",
    "runtime": "docker",
    "pullPolicy": "never"
  },
  "rootfs": {
    "label": "pi-gondolin-root",
    "sizeMb": 4096
  },
  "init": {
    "rootfsInitExtra": "docker-init-extra.sh"
  },
  "runtimeDefaults": {
    "rootfsMode": "memory"
  }
}
