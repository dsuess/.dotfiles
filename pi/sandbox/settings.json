{
  "version": 1,
  "filesystem": {
    "workspace": {
      "access": "rw",
      "writeProtectedPaths": [
        ".gitconfig",
        ".gitmodules",
        ".bashrc",
        ".bash_profile",
        ".zshrc",
        ".zprofile",
        ".profile",
        ".ripgreprc",
        ".mcp.json",
        ".vscode",
        ".idea",
        ".claude/commands",
        ".claude/agents",
        ".agents",
        ".pi",
        ".git/hooks",
        ".git/config",
        "bin/pi",
        "pi/sandbox",
        "pi/agent"
      ]
    },
    "workspaceOverrides": [
      {
        "root": "~/.dotfiles",
        "access": "rw",
        "writeProtectedPaths": []
      }
    ],
    "bareCommon": {
      "access": "rw",
      "writeProtectedPaths": ["hooks", "config"]
    },
    "externalMounts": [
      { "path": "~/.ssh/git/id_ed25519_signing.pub", "access": "ro" }
    ]
  },
  "network": {
    "mode": "public-tcp",
    "allowedHosts": [],
    "allowWebSockets": false,
    "tcpMappings": []
  },
  "ingress": {
    "workspaceProfiles": [
      {
        "root": "~/src/visonic/dev",
        "allowWebSockets": true,
        "listeners": [
          { "name": "manager", "hostPort": 28080, "guestPort": 28080 },
          { "name": "ui", "hostPort": 25173, "guestPort": 25173 },
          { "name": "storybook", "hostPort": 26006, "guestPort": 26006 },
          { "name": "conductor", "hostPort": 28083, "guestPort": 28083 },
          { "name": "processor-cpu", "hostPort": 28081, "guestPort": 28081 },
          { "name": "processor-gpu", "hostPort": 28082, "guestPort": 28082 }
        ]
      }
    ]
  }
}
