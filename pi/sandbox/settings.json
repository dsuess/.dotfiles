{
  "network": {
    "allowedDomains": [],
    "deniedDomains": [],
    "allowAllUnixSockets": true,
    "allowLocalBinding": true,
    "allowMachLookup": ["com.apple.pasteboard.1"]
  },
  "filesystem": {
    "denyRead": ["~"],
    "allowRead": [
      ".",
      "~/src",

      "~/.pi/",
      "~/.agents/skills",
      "~/.dotfiles",

      "~/bin",
      "~/.local/bin",
      "~/.gitconfig",
      "~/.gitconfig.local",
      "~/.gitignore",
      "~/.config/git",
      "~/.config/uv",
      "~/.config/rtk",
      "~/.config/ketch",
      "~/Library/Application Support/ketch",
      "~/.config/herdr/config.toml",

      "~/.profile",
      "~/.bash_profile",
      "~/.bashrc",
      "~/.zprofile",
      "~/.zshenv",
      "~/.zshrc",
      "~/.ssh/config",
      "~/.ssh/known_hosts",

      "~/.cargo",
      "~/.rustup",

      "~/.cache/pi-sandbox",
      "~/.cache/uv",
      "~/.uv/cache",
      "~/.local/share/uv",
      "~/.cache/huggingface",
      "~/.serena/",
      "~/Library/Caches/ketch",

      "~/.config/nvim",
      "~/.dotfiles/nvim",
      "~/.local/share/nvim",
      "~/.local/state/nvim",
      "~/.cache/nvim",

      "~/.local/share/rtk",
      "~/Library/Application Support/rtk"
    ],
    "allowWrite": [
      ".",
      "/tmp",

      "~/.pi/agent",
      "~/.dotfiles/pi/agent",

      "~/.cache/pi-sandbox",
      "~/.cache/uv",
      "~/.uv/cache",
      "~/.local/share/uv",
      "~/.cache/huggingface",
      "~/.serena/",
      "~/Library/Caches/ketch",

      "~/.cargo",
      "~/.rustup",

      "~/.local/state/nvim",
      "~/.cache/nvim",

      "~/.config/rtk",
      "~/.local/share/rtk",
      "~/Library/Application Support/rtk"
    ],
    "denyWrite": [
      "~/bin/pi",
      "~/.pi/sandbox",
      "~/.config/ketch",
      "~/Library/Application Support/ketch",
      "~/.dotfiles/ketch",
      "~/.dotfiles/bin/pi",
      "~/.dotfiles/pi/sandbox"
    ],
    "allowGitConfig": false
  },
  "credentials": {
    "files": [
      {
        "path": "~/.gnupg",
        "mode": "deny"
      },
      {
        "path": "~/.aws",
        "mode": "deny"
      },
      {
        "path": "~/.azure",
        "mode": "deny"
      },
      {
        "path": "~/.kube",
        "mode": "deny"
      },
      {
        "path": "~/.docker/config.json",
        "mode": "deny"
      },
      {
        "path": "~/.config/gcloud",
        "mode": "deny"
      },
      {
        "path": "~/.config/gh",
        "mode": "deny"
      },
      {
        "path": "~/.config/op",
        "mode": "deny"
      },
      {
        "path": "~/.netrc",
        "mode": "deny"
      },
      {
        "path": "~/.npmrc",
        "mode": "deny"
      },
      {
        "path": "~/.pypirc",
        "mode": "deny"
      },
      {
        "path": "~/.cargo/credentials",
        "mode": "deny"
      },
      {
        "path": "~/.cargo/credentials.toml",
        "mode": "deny"
      }
    ],
    "envVars": []
  },
  "enableWeakerNestedSandbox": false,
  "enableWeakerNetworkIsolation": true,
  "allowAppleEvents": false,
  "allowPty": true
}
