{
  "name": "pi-gondolin-runtime",
  "private": true,
  "version": "1.0.0",
  "description": "Pinned Gondolin tool-plane runtime for Pi",
  "scripts": {
    "build:image": "node build-gondolin-image.mjs",
    "test": "npm run test:broker && npm run test:controller && npm run test:extension && npm run test:wrapper && npm run test:repository && npm run test:ketch-config",
    "test:native": "npm run test:canary && npm run test:controller-native && npm run test:tools-native && npm run test:inventory && npm run test:ketch-live",
    "test:broker": "node --test test-herdr-status-broker.mjs test-herdr-agent-state.mjs test-herdr-sandbox-composed.mjs",
    "test:controller": "node --test test-policy.mjs test-protocol.mjs test-controller.mjs",
    "test:controller-native": "node --test test-controller-integration.mjs",
    "test:extension": "node --test ../agent/extensions/gondolin-sandbox/*.test.mjs",
    "test:inventory": "node --test test-gondolin-extension-production.mjs",
    "test:tools-native": "node --test test-gondolin-tools-native.mjs",
    "test:canary": "node test-gondolin-canary.mjs",
    "test:wrapper": "bash test-wrapper.sh",
    "test:repository": "node --test test-repository-scope.mjs",
    "test:ketch-config": "bash test-ketch-config.sh",
    "test:ketch-live": "bash test-ketch-live.sh"
  },
  "dependencies": {
    "@earendil-works/gondolin": "0.12.0"
  }
}
