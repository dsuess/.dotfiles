{
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_INSTALLATION_CHECKS": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(bazel *)",
      "Bash(rtk *)",
      "Bash(mamba env list)",
      "Bash(strings *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/dsuess/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-powerline@claude-powerline": true
  },
  "extraKnownMarketplaces": {
    "claude-powerline": {
      "source": {
        "source": "github",
        "repo": "Owloops/claude-powerline"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        ".",
        "~/.claude",
        "~/.uv/cache",
        "~/.cache/uv",
        "~/.local/share/uv"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        ".",
        "~/src",
        "~/.gitconfig",
        "~/.gitconfig.local",
        "~/.dotfiles",
        "~/.cache/uv",
        "~/.local/share/uv"
      ]
    },
    "excludedCommands": [
      "bazel"
    ]
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoMode": {
    "allow": [
      "$defaults",
      "Redirecting or writing command output to $TMPDIR, or any path under the session's sandboxed scratch/temp directory, is allowed even when the path is built from shell variables or command substitution: the sandbox already confines writes to the working directory and $TMPDIR, so these writes cannot escape that scope."
    ]
  },
  "voiceEnabled": true
}
