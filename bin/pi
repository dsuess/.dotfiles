#!/bin/bash -p
set -euo pipefail

readonly SANDBOX_DIR="$HOME/.pi/sandbox"
readonly GONDOLIN_CLIENT="$SANDBOX_DIR/client-cli.mjs"
readonly GONDOLIN_CONTROLLER="$SANDBOX_DIR/controller.mjs"
readonly GONDOLIN_SETTINGS="$SANDBOX_DIR/settings.json"
readonly GONDOLIN_EXTENSION="$HOME/.pi/agent/extensions/gondolin-sandbox/index.ts"
readonly HERDR_STATUS_BROKER="$SANDBOX_DIR/herdr-status-broker.mjs"
readonly REPOSITORY_SCOPE="$SANDBOX_DIR/repository-scope.mjs"

HERDR_BROKER_PID=""
HERDR_BROKER_DIR=""
HANDSHAKE_DIR=""
PI_CHILD_PID=""
CONTROLLER_LEASE=""

trace_startup() {
    local phase="$1"
    local trace_file="${PI_GONDOLIN_STARTUP_TRACE_FILE-}"

    [[ "$trace_file" == /* && "$trace_file" != *$'\n'* && "$trace_file" != *$'\r'* && "$trace_file" != *$'\t'* ]] || return 0
    printf '%s\n' "$phase" >>"$trace_file" 2>/dev/null || true
}
CONTROLLER_SOCKET=""
CONTROLLER_WORKSPACE_KEY=""
CONTROLLER_WORKSPACE_ROOT=""
CONTROLLER_POLICY_GENERATION=""
CONTROLLER_IMAGE_GENERATION=""
CONTROLLER_VM_ID=""

cleanup_herdr_broker() {
    [[ -n "$HERDR_BROKER_PID" ]] || return 0

    kill -TERM "$HERDR_BROKER_PID" 2>/dev/null || true
    for _ in {1..100}; do
        kill -0 "$HERDR_BROKER_PID" 2>/dev/null || break
        /bin/sleep 0.01
    done
    kill -KILL "$HERDR_BROKER_PID" 2>/dev/null || true
    wait "$HERDR_BROKER_PID" 2>/dev/null || true
    [[ -z "$HERDR_BROKER_DIR" ]] || /bin/rm -rf -- "$HERDR_BROKER_DIR"
}

release_controller_lease() {
    [[ -n "$CONTROLLER_LEASE" && -n "${HOST_NODE-}" ]] || return 0
    /usr/bin/env -i \
        HOME="$HOME" \
        PATH="${CONTROLLER_PATH-}" \
        TMPDIR="${TMPDIR:-/tmp}" \
        "$HOST_NODE" "$GONDOLIN_CLIENT" release \
        --socket "$CONTROLLER_SOCKET" \
        --lease "$CONTROLLER_LEASE" \
        --workspace-key "$CONTROLLER_WORKSPACE_KEY" \
        --workspace-root "$CONTROLLER_WORKSPACE_ROOT" \
        --policy-generation "$CONTROLLER_POLICY_GENERATION" \
        --image-generation "$CONTROLLER_IMAGE_GENERATION" \
        --vm-id "$CONTROLLER_VM_ID" \
        >/dev/null 2>&1 || true
    CONTROLLER_LEASE=""
}

cleanup_launcher() {
    cleanup_herdr_broker
    release_controller_lease
    [[ -z "$HANDSHAKE_DIR" ]] || /bin/rm -rf -- "$HANDSHAKE_DIR"
}

forward_signal() {
    local signal="$1"
    [[ -n "$PI_CHILD_PID" ]] || return 0
    kill -"$signal" "$PI_CHILD_PID" 2>/dev/null || true
}

die() {
    echo "pi: sandbox initialization failed: $*" >&2
    exit 1
}

readonly LAUNCH_DIR="$(builtin pwd -P)"

BOOTSTRAP_EXCLUDED_ROOTS=("$LAUNCH_DIR")
CANDIDATE_WORKTREE_ROOT=""
EXPECTED_WORKSPACE_ROOT=""
EXPECTED_WORKSPACE_KEY=""

path_is_within() {
    local candidate="$1"
    local root="$2"

    [[ "$root" == "/" || "$candidate" == "$root" || "$candidate" == "$root/"* ]]
}

canonical_directory() {
    local directory="$1"

    (
        builtin cd -- "$directory" 2>/dev/null || exit 1
        builtin pwd -P
    )
}

add_bootstrap_exclusion() {
    local root="$1"
    local existing

    [[ "$root" == /* ]] || return 0
    for existing in "${BOOTSTRAP_EXCLUDED_ROOTS[@]}"; do
        [[ "$root" == "$existing" ]] && return 0
    done
    BOOTSTRAP_EXCLUDED_ROOTS+=("$root")
}

# Locate the nearest .git marker without executing Git or anything from the
# candidate repository. These paths are exclusions only; they do not grant
# sandbox access until a trusted host Git validates them below.
discover_bootstrap_exclusions() {
    local cursor="$LAUNCH_DIR"
    local dot_git metadata_hint metadata_dir common_hint common_dir

    while :; do
        dot_git="$cursor/.git"
        if [[ -e "$dot_git" || -L "$dot_git" ]]; then
            CANDIDATE_WORKTREE_ROOT="$cursor"
            add_bootstrap_exclusion "$cursor"

            if [[ -d "$dot_git" ]]; then
                metadata_dir="$(canonical_directory "$dot_git")" || return 0
            elif [[ -f "$dot_git" ]]; then
                IFS= read -r metadata_hint <"$dot_git" || return 0
                [[ "$metadata_hint" == "gitdir: "* ]] || return 0
                metadata_hint="${metadata_hint#gitdir: }"
                [[ -n "$metadata_hint" ]] || return 0
                if [[ "$metadata_hint" != /* ]]; then
                    metadata_hint="$cursor/$metadata_hint"
                fi
                metadata_dir="$(canonical_directory "$metadata_hint")" || return 0
            else
                return 0
            fi
            add_bootstrap_exclusion "$metadata_dir"

            if [[ -f "$metadata_dir/commondir" ]]; then
                IFS= read -r common_hint <"$metadata_dir/commondir" || return 0
                [[ -n "$common_hint" ]] || return 0
                if [[ "$common_hint" != /* ]]; then
                    common_hint="$metadata_dir/$common_hint"
                fi
                common_dir="$(canonical_directory "$common_hint")" || return 0
                add_bootstrap_exclusion "$common_dir"
            fi
            return 0
        fi
        [[ "$cursor" == "/" ]] && return 0
        cursor="${cursor%/*}"
        [[ -n "$cursor" ]] || cursor="/"
    done
}

discover_bootstrap_exclusions

bootstrap_path_is_allowed() {
    local candidate="$1"
    local excluded

    for excluded in "${BOOTSTRAP_EXCLUDED_ROOTS[@]}"; do
        path_is_within "$candidate" "$excluded" && return 1
    done
    return 0
}

canonical_executable() {
    local candidate="$1"

    if [[ -x /usr/bin/realpath ]]; then
        /usr/bin/realpath "$candidate" 2>/dev/null
    elif [[ -x /bin/realpath ]]; then
        /bin/realpath "$candidate" 2>/dev/null
    elif [[ ! -L "$candidate" ]]; then
        printf '%s\n' "$candidate"
    else
        return 1
    fi
}

# Resolve canonical bootstrap directories once, after repository exclusions
# are known. Every trusted lookup preserves this first-match ordering.
SAFE_PATH_ENTRIES=()
raw_path_entries=()
IFS=: read -r -a raw_path_entries <<<"${PATH-}"
for entry in "${raw_path_entries[@]}"; do
    [[ "$entry" == /* ]] || continue
    resolved_dir="$(canonical_directory "$entry")" || continue
    bootstrap_path_is_allowed "$resolved_dir" || continue
    duplicate=false
    for existing in ${SAFE_PATH_ENTRIES[@]+"${SAFE_PATH_ENTRIES[@]}"}; do
        [[ "$resolved_dir" == "$existing" ]] && duplicate=true && break
    done
    [[ "$duplicate" == true ]] || SAFE_PATH_ENTRIES+=("$resolved_dir")
done
readonly SAFE_PATH_ENTRIES

find_host_executable() {
    local name="$1"
    local entry candidate resolved_candidate

    for entry in ${SAFE_PATH_ENTRIES[@]+"${SAFE_PATH_ENTRIES[@]}"}; do
        candidate="$entry/$name"
        [[ -x "$candidate" && ! -d "$candidate" ]] || continue
        resolved_candidate="$(canonical_executable "$candidate")" || continue
        [[ -x "$resolved_candidate" && ! -d "$resolved_candidate" ]] || continue
        bootstrap_path_is_allowed "$resolved_candidate" || continue
        printf '%s\n' "$resolved_candidate"
        return 0
    done

    return 1
}

find_real_pi() {
    local candidate entry resolved_candidate

    for entry in ${SAFE_PATH_ENTRIES[@]+"${SAFE_PATH_ENTRIES[@]}"}; do
        candidate="$entry/pi"
        [[ -x "$candidate" ]] || continue
        resolved_candidate="$(canonical_executable "$candidate")" || continue
        bootstrap_path_is_allowed "$resolved_candidate" || continue
        [[ "$resolved_candidate" -ef "${BASH_SOURCE[0]}" ]] && continue
        printf '%s\n' "$resolved_candidate"
        return 0
    done

    return 1
}

discover_repository_scope() {
    [[ -r "$REPOSITORY_SCOPE" ]] || die "repository scope module is missing: $REPOSITORY_SCOPE"
    local result
    result="$(trusted_node --input-type=module - "$REPOSITORY_SCOPE" "$LAUNCH_DIR" "${PATH-}" <<'NODE'
import { pathToFileURL } from "node:url";
const [modulePath, launchDirectory, pathValue] = process.argv.slice(2);
const module = await import(pathToFileURL(modulePath).href);
process.stdout.write(JSON.stringify(module.discoverRepositoryScope({ launchDirectory, pathValue })));
NODE
)" || die "repository scope discovery failed"
    EXPECTED_WORKSPACE_ROOT="$(trusted_node -e 'process.stdout.write(JSON.parse(process.argv[1]).canonicalWorkspaceRoot)' "$result")" ||
        die "repository workspace result is invalid"
    EXPECTED_WORKSPACE_KEY="$(trusted_node -e 'process.stdout.write(JSON.parse(process.argv[1]).workspaceKey)' "$result")" ||
        die "repository workspace key is invalid"
}

yolo=false
pi_args=()
for arg in "$@"; do
    if [[ "$arg" == --yolo ]]; then
        yolo=true
    else
        pi_args+=("$arg")
    fi
done

if [[ "$yolo" == true ]]; then
    real_pi="$(find_real_pi)" || die "cannot find the installed Pi binary behind this wrapper"
    echo "pi: warning: sandbox disabled by --yolo" >&2
    exec "$real_pi" ${pi_args[@]+"${pi_args[@]}"}
fi

case "$OSTYPE" in
    darwin*|linux*) ;;
    *) die "only macOS and Linux are supported" ;;
esac

case "$(uname -m)" in
    arm64|aarch64) qemu_name="qemu-system-aarch64" ;;
    x86_64|amd64) qemu_name="qemu-system-x86_64" ;;
    *) die "unsupported Gondolin architecture: $(uname -m)" ;;
esac
host_qemu="$(find_host_executable "$qemu_name")" || die "$qemu_name is required"
readonly HOST_QEMU="$host_qemu"

host_node="$(find_host_executable node)" || die "Node.js is required"
readonly HOST_NODE="$host_node"
trusted_node() {
    /usr/bin/env -i \
        HOME="$HOME" \
        PATH="${HOST_NODE%/*}:/usr/bin:/bin" \
        LC_ALL=C \
        "$HOST_NODE" "$@"
}
trusted_node -e '
    const [major, minor] = process.versions.node.split(".").map(Number);
    process.exit(major > 23 || (major === 23 && minor >= 6) ? 0 : 1);
' || die "Node.js 23.6 or newer is required"

discover_repository_scope
readonly EXPECTED_WORKSPACE_ROOT EXPECTED_WORKSPACE_KEY

host_rg="$(find_host_executable rg)" || die "ripgrep (rg) is required"
readonly HOST_RG="$host_rg"
host_mktemp="$(find_host_executable mktemp)" || die "mktemp is required"
readonly HOST_MKTEMP="$host_mktemp"
trusted_mktemp() {
    /usr/bin/env -i \
        HOME="$HOME" \
        PATH="${HOST_MKTEMP%/*}:/usr/bin:/bin" \
        LC_ALL=C \
        "$HOST_MKTEMP" "$@"
}

CONTROLLER_PATH="$(IFS=:; printf '%s' "${SAFE_PATH_ENTRIES[*]}")"
readonly CONTROLLER_PATH
trusted_controller_node() {
    /usr/bin/env -i \
        HOME="$HOME" \
        PATH="$CONTROLLER_PATH" \
        TMPDIR="${TMPDIR:-/tmp}" \
        LC_ALL=C \
        PI_GONDOLIN_STARTUP_TRACE_FILE="${PI_GONDOLIN_STARTUP_TRACE_FILE-}" \
        "$HOST_NODE" "$@"
}

[[ -r "$GONDOLIN_CLIENT" ]] || die "Gondolin client is missing: $GONDOLIN_CLIENT"
[[ -r "$GONDOLIN_CONTROLLER" ]] || die "Gondolin controller is missing: $GONDOLIN_CONTROLLER"
[[ -r "$GONDOLIN_SETTINGS" ]] || die "Gondolin settings are missing: $GONDOLIN_SETTINGS"
[[ -r "$GONDOLIN_EXTENSION" ]] || die "Gondolin routing extension is missing: $GONDOLIN_EXTENSION"
real_pi="$(find_real_pi)" || die "cannot find the installed Pi binary behind this wrapper"
readonly REAL_PI="$real_pi"
readonly REAL_PI_DIR="${REAL_PI%/*}"

BUILTIN_TOOL_NAMES=(read write edit bash grep find ls)
HOST_TOOL_NAMES=(
    ketch_search ketch_scrape ketch_code ketch_docs ketch_crawl
    ask_user_question subagent submit_plan plan_progress complete_plan complete_stage
)
requested_builtins=()
requested_hosts=()
excluded_tools=()
tools_explicit=false
no_tools=false
no_builtin_tools=false

append_unique_tool() {
    local group="$1" name="$2" existing
    if [[ "$group" == builtin ]]; then
        for existing in ${requested_builtins[@]+"${requested_builtins[@]}"}; do [[ "$existing" == "$name" ]] && return 0; done
        requested_builtins+=("$name")
    else
        for existing in ${requested_hosts[@]+"${requested_hosts[@]}"}; do [[ "$existing" == "$name" ]] && return 0; done
        requested_hosts+=("$name")
    fi
}

classify_requested_tool() {
    local name="$1" candidate
    [[ -n "$name" ]] || return 0
    for candidate in "${BUILTIN_TOOL_NAMES[@]}"; do
        [[ "$candidate" == "$name" ]] && append_unique_tool builtin "$name" && return 0
    done
    for candidate in "${HOST_TOOL_NAMES[@]}"; do
        [[ "$candidate" == "$name" ]] && append_unique_tool host "$name" && return 0
    done
    die "tool '$name' is not an audited sandbox tool or host adapter"
}

parse_requested_tool_list() {
    local value="$1" name
    local names=()
    IFS=, read -r -a names <<<"$value"
    for name in "${names[@]}"; do classify_requested_tool "$name"; done
}

parse_excluded_tool_list() {
    local value="$1" name
    local names=()
    IFS=, read -r -a names <<<"$value"
    for name in "${names[@]}"; do [[ -n "$name" ]] && excluded_tools+=("$name"); done
}

raw_args=(${pi_args[@]+"${pi_args[@]}"})
pi_args=()
index=0
while (( index < ${#raw_args[@]} )); do
    arg="${raw_args[$index]}"
    case "$arg" in
        --no-extensions|--no-extensions=*)
            die "--no-extensions is incompatible with sandboxed mode; use --yolo for host built-ins"
            ;;
        --tools|-t)
            ((index += 1))
            (( index < ${#raw_args[@]} )) || die "$arg requires a comma-separated value"
            tools_explicit=true
            parse_requested_tool_list "${raw_args[$index]}"
            ;;
        --tools=*|-t=*)
            tools_explicit=true
            parse_requested_tool_list "${arg#*=}"
            ;;
        --exclude-tools|-xt)
            ((index += 1))
            (( index < ${#raw_args[@]} )) || die "$arg requires a comma-separated value"
            parse_excluded_tool_list "${raw_args[$index]}"
            ;;
        --exclude-tools=*|-xt=*) parse_excluded_tool_list "${arg#*=}" ;;
        --no-tools|-nt) no_tools=true ;;
        --no-builtin-tools|-nbt) no_builtin_tools=true ;;
        *) pi_args+=("$arg") ;;
    esac
    ((index += 1))
done

if [[ "$tools_explicit" == false ]]; then
    requested_builtins=("${BUILTIN_TOOL_NAMES[@]}")
    requested_hosts=("${HOST_TOOL_NAMES[@]}")
fi
if [[ "$no_tools" == true ]]; then
    requested_builtins=()
    requested_hosts=()
elif [[ "$no_builtin_tools" == true ]]; then
    requested_builtins=()
fi
if ((${#excluded_tools[@]})); then
    filtered=()
    for candidate in ${requested_builtins[@]+"${requested_builtins[@]}"}; do
        excluded=false
        for name in ${excluded_tools[@]+"${excluded_tools[@]}"}; do [[ "$candidate" == "$name" ]] && excluded=true; done
        [[ "$excluded" == true ]] || filtered+=("$candidate")
    done
    requested_builtins=(${filtered[@]+"${filtered[@]}"})
    filtered=()
    for candidate in ${requested_hosts[@]+"${requested_hosts[@]}"}; do
        excluded=false
        for name in ${excluded_tools[@]+"${excluded_tools[@]}"}; do [[ "$candidate" == "$name" ]] && excluded=true; done
        [[ "$excluded" == true ]] || filtered+=("$candidate")
    done
    requested_hosts=(${filtered[@]+"${filtered[@]}"})
fi
readonly REQUESTED_BUILTINS="$(IFS=,; printf '%s' "${requested_builtins[*]-}")"
readonly REQUESTED_HOST_TOOLS="$(IFS=,; printf '%s' "${requested_hosts[*]-}")"
pi_args+=(--no-builtin-tools)

umask 077
trap cleanup_launcher EXIT
trace_startup controller_acquire_start
lease_json="$(trusted_controller_node "$GONDOLIN_CLIENT" acquire \
    --launch-dir "$LAUNCH_DIR" \
    --settings "$GONDOLIN_SETTINGS" \
    --client-id "launcher-$$")" || die "could not acquire the workspace Gondolin controller"
trace_startup controller_acquire_complete
lease_record="$(trusted_node -e '
const value = JSON.parse(process.argv[1]);
const [expectedRoot, expectedKey] = process.argv.slice(2);
const expectedKeys = [
  "version", "socketPath", "leaseToken", "workspaceKey", "workspaceRoot",
  "bareCommonDirectory", "policyGeneration", "imageGeneration", "vmId",
  "dockerHealthy", "controllerPid", "runtimeRoot",
];
const safeText = (entry, limit = 4096) => typeof entry === "string" && entry.length > 0 &&
  entry.length <= limit && !/[\t\r\n\0]/.test(entry);
const hex = entry => typeof entry === "string" && /^[0-9a-f]{64}$/.test(entry);
if (!value || typeof value !== "object" || Array.isArray(value) ||
    Object.keys(value).length !== expectedKeys.length ||
    expectedKeys.some(key => !Object.hasOwn(value, key)) || value.version !== 1 ||
    !hex(value.leaseToken) || !hex(value.workspaceKey) || !hex(value.policyGeneration) ||
    !hex(value.imageGeneration) || value.workspaceKey !== expectedKey ||
    value.workspaceRoot !== expectedRoot || !safeText(value.socketPath) ||
    !safeText(value.workspaceRoot) || !safeText(value.runtimeRoot) || !safeText(value.vmId, 256) ||
    !value.socketPath.startsWith("/") || !value.workspaceRoot.startsWith("/") ||
    !value.runtimeRoot.startsWith("/") || value.dockerHealthy !== true ||
    !Number.isSafeInteger(value.controllerPid) || value.controllerPid < 1 ||
    (value.bareCommonDirectory !== null &&
      (!safeText(value.bareCommonDirectory) || !value.bareCommonDirectory.startsWith("/")))) {
  console.error("lease manifest is invalid or mismatched");
  process.exit(1);
}
process.stdout.write([
  value.leaseToken, value.socketPath, value.workspaceKey, value.workspaceRoot,
  value.policyGeneration, value.imageGeneration, value.vmId, value.runtimeRoot,
].join("\t"));
' "$lease_json" "$EXPECTED_WORKSPACE_ROOT" "$EXPECTED_WORKSPACE_KEY")" ||
    die "controller returned an invalid or mismatched lease manifest"
IFS=$'\t' read -r CONTROLLER_LEASE CONTROLLER_SOCKET CONTROLLER_WORKSPACE_KEY CONTROLLER_WORKSPACE_ROOT \
    CONTROLLER_POLICY_GENERATION CONTROLLER_IMAGE_GENERATION CONTROLLER_VM_ID CONTROLLER_RUNTIME_ROOT <<<"$lease_record" ||
    die "controller returned an invalid lease record"
readonly CONTROLLER_SOCKET CONTROLLER_WORKSPACE_KEY CONTROLLER_WORKSPACE_ROOT
readonly CONTROLLER_POLICY_GENERATION CONTROLLER_IMAGE_GENERATION CONTROLLER_VM_ID CONTROLLER_RUNTIME_ROOT
HANDSHAKE_DIR="$(trusted_mktemp -d "$CONTROLLER_RUNTIME_ROOT/handshake.XXXXXX")" ||
    die "cannot create the Gondolin handshake directory"
readonly HANDSHAKE_FILE="$HANDSHAKE_DIR/ready.json"

# Put only the real Pi package ahead of the trusted caller PATH. Nested Pi
# processes inherit the controller capability and do not re-enter this launcher.
# Preserve first-match resolution after excluding repository paths.
inner_path_entries=("$REAL_PI_DIR")
for entry in ${SAFE_PATH_ENTRIES[@]+"${SAFE_PATH_ENTRIES[@]}"}; do
    [[ "$entry" == "$REAL_PI_DIR" ]] || inner_path_entries+=("$entry")
done
readonly inner_path="$(IFS=:; printf '%s' "${inner_path_entries[*]}")"

startup_trace_file=""
if [[ "${PI_GONDOLIN_STARTUP_TRACE_FILE-}" == /* && "${PI_GONDOLIN_STARTUP_TRACE_FILE-}" != *$'\n'* && "${PI_GONDOLIN_STARTUP_TRACE_FILE-}" != *$'\r'* && "${PI_GONDOLIN_STARTUP_TRACE_FILE-}" != *$'\t'* ]]; then
    startup_trace_file="$PI_GONDOLIN_STARTUP_TRACE_FILE"
fi
readonly startup_trace_file

# Keep ambient cloud, package-manager, SSH, and application credentials out of
# the host Pi environment. Pi still uses its managed auth.json on the host.
safe_env=(
    "HOME=$HOME"
    "PATH=$inner_path"
    "TMPDIR=/tmp"
    "XDG_CACHE_HOME=$HOME/.cache/pi-gondolin/host"
    "NPM_CONFIG_CACHE=$HOME/.cache/pi-gondolin/host/npm"
    "PIP_CACHE_DIR=$HOME/.cache/pi-gondolin/host/pip"
    "CONDA_PKGS_DIRS=$HOME/.cache/pi-gondolin/host/conda"
    "UV_CACHE_DIR=$HOME/.cache/uv"
    "HF_HOME=$HOME/.cache/huggingface"
    "CARGO_HOME=$HOME/.cargo"
    "PI_GONDOLIN_SANDBOX=1"
    "PI_GONDOLIN_SOCKET=$CONTROLLER_SOCKET"
    "PI_GONDOLIN_LEASE=$CONTROLLER_LEASE"
    "PI_GONDOLIN_WORKSPACE_KEY=$CONTROLLER_WORKSPACE_KEY"
    "PI_GONDOLIN_WORKSPACE_ROOT=$CONTROLLER_WORKSPACE_ROOT"
    "PI_GONDOLIN_POLICY_GENERATION=$CONTROLLER_POLICY_GENERATION"
    "PI_GONDOLIN_IMAGE_GENERATION=$CONTROLLER_IMAGE_GENERATION"
    "PI_GONDOLIN_VM_ID=$CONTROLLER_VM_ID"
    "PI_GONDOLIN_BUILTIN_TOOLS=$REQUESTED_BUILTINS"
    "PI_GONDOLIN_HOST_TOOLS=$REQUESTED_HOST_TOOLS"
    "PI_GONDOLIN_HANDSHAKE_FILE=$HANDSHAKE_FILE"
    "PI_GONDOLIN_STARTUP_TRACE_FILE=$startup_trace_file"
)

for name in \
    USER LOGNAME SHELL TERM COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION \
    LANG LC_ALL LC_CTYPE TZ EDITOR VISUAL PAGER NO_COLOR FORCE_COLOR
do
    value="${!name-}"
    [[ -n "$value" ]] && safe_env+=("$name=$value")
done

start_herdr_broker() {
    [[ "${HERDR_ENV-}" == "1" ]] || return 0
    [[ -n "${HERDR_SOCKET_PATH-}" && -n "${HERDR_PANE_ID-}" ]] || return 0
    [[ -r "$HERDR_STATUS_BROKER" ]] || die "Herdr status broker is missing: $HERDR_STATUS_BROKER"
    [[ -d "$HOME/.pi/agent/sessions" ]] || die "Pi session directory is missing"

    HERDR_BROKER_DIR="$(trusted_mktemp -d /tmp/pi-herdr-status.XXXXXX)" ||
        die "cannot create the Herdr status broker directory"
    local ready_file="$HERDR_BROKER_DIR/ready"
    local error_file="$HERDR_BROKER_DIR/error.log"

    /usr/bin/env -i \
        HERDR_PI_BROKER_READY_FILE="$ready_file" \
        HERDR_PI_BROKER_DIR="$HERDR_BROKER_DIR" \
        HERDR_PI_BROKER_PARENT_PID="$$" \
        HERDR_PI_SESSION_ROOT="$HOME/.pi/agent/sessions" \
        HERDR_SOCKET_PATH="$HERDR_SOCKET_PATH" \
        HERDR_PANE_ID="$HERDR_PANE_ID" \
        "$HOST_NODE" "$HERDR_STATUS_BROKER" </dev/null > /dev/null 2>"$error_file" &
    HERDR_BROKER_PID=$!

    for _ in {1..200}; do
        [[ -s "$ready_file" ]] && break
        if ! kill -0 "$HERDR_BROKER_PID" 2>/dev/null; then
            die "Herdr status broker failed to start: $(<"$error_file")"
        fi
        /bin/sleep 0.01
    done
    [[ -s "$ready_file" ]] || die "timed out starting the Herdr status broker"

    local status_port status_token extra
    IFS=' ' read -r status_port status_token extra <"$ready_file"
    [[ "$status_port" =~ ^[0-9]+$ && "$status_port" -ge 1 && "$status_port" -le 65535 ]] ||
        die "Herdr status broker returned an invalid port"
    [[ "$status_token" =~ ^[0-9a-f]{64}$ && -z "$extra" ]] ||
        die "Herdr status broker returned an invalid token"

    # Pi receives only the narrow broker capability. The real Herdr socket path
    # is not passed into Pi, and the broker ignores caller-supplied pane, source,
    # agent, and sequence values.
    safe_env+=(
        "HERDR_ENV=1"
        "HERDR_PANE_ID=$HERDR_PANE_ID"
        "HERDR_PI_STATUS_PORT=$status_port"
        "HERDR_PI_STATUS_TOKEN=$status_token"
    )
}

start_herdr_broker

requires_handshake=true
for arg in "${pi_args[@]}"; do
    case "$arg" in
        -h|--help|-v|--version|--list-models|--list-models=*) requires_handshake=false ;;
    esac
done
if ((${#raw_args[@]})) && [[ "${raw_args[0]}" =~ ^(install|remove|uninstall|update|list|config)$ ]]; then
    requires_handshake=false
fi

trace_startup pi_child_spawn
set +e
/usr/bin/env -i "${safe_env[@]}" \
    /bin/bash -c '
            builtin cd -- "$1" || exit 1
            shift
            real_pi="$1"
            shift

            trace_real_pi() {
                local trace_file="${PI_GONDOLIN_STARTUP_TRACE_FILE-}"
                [[ -n "$trace_file" ]] || return 0
                printf "%s\\n" real_pi_launch >>"$trace_file" 2>/dev/null || true
            }
            exec_real_pi() {
                trace_real_pi
                exec "$real_pi" "$@"
            }

            # Pi resolves enabledModels and its normal default model during its
            # own startup. Planning defaults are selected by the awaited plan-mode
            # session_start handler. Only the catalog command must bypass the
            # settings model scope.
            for arg in "$@"; do
                case "$arg" in
                    --list-models|--list-models=*) exec_real_pi --models "*" "$@" ;;
                esac
            done
            exec_real_pi "$@"
    ' \
    pi-gondolin-launch "$LAUNCH_DIR" "$REAL_PI" ${pi_args[@]+"${pi_args[@]}"} <&0 &
PI_CHILD_PID=$!
trap 'forward_signal TERM' TERM
trap 'forward_signal INT' INT
trap 'forward_signal HUP' HUP

if [[ "$requires_handshake" == true ]]; then
    trace_startup routing_handshake_start
    timeout_ms="${PI_GONDOLIN_HANDSHAKE_TIMEOUT_MS:-15000}"
    [[ "$timeout_ms" =~ ^[0-9]+$ && "$timeout_ms" -ge 100 ]] || timeout_ms=15000
    attempts=$((timeout_ms / 25))
    ((attempts > 0)) || attempts=1
    handshake_ready=false
    for ((attempt = 0; attempt < attempts; attempt += 1)); do
        if [[ -s "$HANDSHAKE_FILE" ]]; then
            if trusted_node -e '
                const fs = require("node:fs");
                const [file, workspaceKey, workspaceRoot, policy, image, vm] = process.argv.slice(1);
                const value = JSON.parse(fs.readFileSync(file, "utf8"));
                const expectedTools = ["bash", "edit", "find", "grep", "ls", "read", "write"];
                if (value.ok !== true || value.workspaceKey !== workspaceKey ||
                    value.workspaceRoot !== workspaceRoot || value.policyGeneration !== policy ||
                    value.imageGeneration !== image || value.vmId !== vm ||
                    value.dockerHealthy !== true || !Array.isArray(value.tools) ||
                    JSON.stringify([...value.tools].sort()) !== JSON.stringify(expectedTools)) {
                    if (value.error) console.error(value.error);
                    process.exit(1);
                }
            ' "$HANDSHAKE_FILE" "$CONTROLLER_WORKSPACE_KEY" "$CONTROLLER_WORKSPACE_ROOT" \
                "$CONTROLLER_POLICY_GENERATION" "$CONTROLLER_IMAGE_GENERATION" "$CONTROLLER_VM_ID"
            then
                handshake_ready=true
                trace_startup routing_handshake_complete
                break
            fi
            kill -TERM "$PI_CHILD_PID" 2>/dev/null || true
            wait "$PI_CHILD_PID" 2>/dev/null || true
            PI_CHILD_PID=""
            die "the Gondolin routing extension rejected its controller or tool inventory"
        fi
        if ! kill -0 "$PI_CHILD_PID" 2>/dev/null; then
            wait "$PI_CHILD_PID" 2>/dev/null
            child_status=$?
            PI_CHILD_PID=""
            die "Pi exited before the Gondolin routing extension became ready (status $child_status)"
        fi
        /bin/sleep 0.025
    done
    if [[ "$handshake_ready" != true ]]; then
        kill -TERM "$PI_CHILD_PID" 2>/dev/null || true
        for _ in {1..100}; do
            kill -0 "$PI_CHILD_PID" 2>/dev/null || break
            /bin/sleep 0.01
        done
        kill -KILL "$PI_CHILD_PID" 2>/dev/null || true
        wait "$PI_CHILD_PID" 2>/dev/null || true
        PI_CHILD_PID=""
        die "timed out waiting for the Gondolin routing extension handshake"
    fi
fi

wait "$PI_CHILD_PID"
status=$?
if kill -0 "$PI_CHILD_PID" 2>/dev/null; then
    wait "$PI_CHILD_PID"
    child_status=$?
    [[ "$status" -ne 0 ]] || status=$child_status
fi
PI_CHILD_PID=""
set -e
exit "$status"
