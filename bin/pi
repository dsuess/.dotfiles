#!/bin/bash -p
set -euo pipefail

readonly SRT_ROOT="$HOME/.pi/sandbox"
readonly ROUTING_EXTENSION="$HOME/.pi/agent/extensions/srt-tool-routing/index.ts"
readonly CONTROLLER_CLIENT="$SRT_ROOT/client-cli.mjs"

fail() {
  printf 'pi: SRT tool routing is unavailable: %s\n' "$*" >&2
  exit 1
}

find_real_pi() {
  local self candidate resolved entry
  self="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  IFS=: read -r -a entries <<<"${PATH:-}"
  for entry in "${entries[@]}"; do
    [[ "$entry" == /* && -x "$entry/pi" ]] || continue
    candidate="$entry/pi"
    resolved="$(/usr/bin/realpath "$candidate" 2>/dev/null || /bin/realpath "$candidate" 2>/dev/null || true)"
    [[ -n "$resolved" && "$resolved" != "$self" ]] || continue
    # Never trust a Pi executable supplied by the repository being routed.
    case "$resolved" in
      "$(pwd -P)"/*|"$HOME/.dotfiles"/*) continue ;;
    esac
    printf '%s\n' "$resolved"
    return 0
  done
  return 1
}

for argument in "$@"; do
  [[ "$argument" != "--yolo" ]] || fail "host-built-in bypasses are not supported"
done

case "$(uname -s)" in
  Darwin) ;;
  *) fail "this runtime requires macOS Seatbelt support" ;;
esac

command -v node >/dev/null 2>&1 || fail "Node.js is required"
[[ -r "$CONTROLLER_CLIENT" ]] || fail "controller client is missing: $CONTROLLER_CLIENT"
[[ -r "$ROUTING_EXTENSION" ]] || fail "routing extension is missing: $ROUTING_EXTENSION"
real_pi="$(find_real_pi)" || fail "cannot resolve the installed Pi binary behind this launcher"

# Informational modes expose no model-directed core tools and must not create
# controller or sidecar state.
for argument in "$@"; do
  case "$argument" in
    -h|--help|--version|--list-models|models|--no-extensions) exec /usr/bin/env PATH="${real_pi%/*}:$PATH" "$real_pi" "$@" ;;
  esac
done

# The client validates the pinned package and prepares a capability descriptor.
# Pi itself stays host-native; no model tools are enabled until the extension
# has attached to the ready controller.
startup="$(node "$CONTROLLER_CLIENT" preflight --launch-dir "$(pwd -P)" --pi "$real_pi")" || fail "controller preflight failed"
[[ "$startup" =~ ^[A-Za-z0-9+/=]+$ ]] || fail "controller returned an invalid capability descriptor"

# Pi must remain the foreground process for interactive terminal ownership.
# The extension keeps the core-tool inventory empty until its own readiness
# gate completes, so this foreground handoff cannot expose host built-ins.
exec /usr/bin/env \
  PATH="${real_pi%/*}:$PATH" \
  PI_SRT_ROUTING=1 \
  PI_SRT_ROUTING_STARTUP_DESCRIPTOR="$startup" \
  "$real_pi" --no-builtin-tools "$@"
